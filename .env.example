# SofikaMax Agent – klucze API i hasła
# Skopiuj ten plik jako .env i uzupełnij wartości. Plik .env nie commituj do repozytorium.

# -----------------------------------------------------------------------------
# FRED (St. Louis Fed) – dane makroekonomiczne (GDP, inflacja, stopy itd.)
# Używane przez: macro_engine, surprise_engine. Załóż klucz na fred.stlouisfed.org
# -----------------------------------------------------------------------------
FRED_API_KEY=

# -----------------------------------------------------------------------------
# MyFXBook – sentyment retail (Layer 4b, kontrarianski)
# Używane przez: sentiment_engine. Limit 100 zapytań/24h. Konto: myfxbook.com
# -----------------------------------------------------------------------------
MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=

# -----------------------------------------------------------------------------
# LLM (OpenAI / Azure / Ollama) – komentarz analityka w raporcie
# Używane przez: commentary_engine. Puste = komentarz tylko z szablonu.
# -----------------------------------------------------------------------------
LLM_API_KEY=
# LLM_BASE_URL=   # opcjonalnie, np. http://localhost:11434/v1 dla Ollama

# -----------------------------------------------------------------------------
# Money.net – globalne stopy, FX, news (opcjonalnie)
# Używane przez: main (sekcja Global Yields). Puste = sekcja pomijana.
# -----------------------------------------------------------------------------
MONEY_NET_API_KEY=

# -----------------------------------------------------------------------------
# News – rozszerzenia (opcjonalnie). Puste = tylko NewsAPI.
# -----------------------------------------------------------------------------
# GUARDIAN_API_KEY=   # Guardian Open Platform
# NYT_API_KEY=        # NYT Developer Network

# -----------------------------------------------------------------------------
# Claude (Anthropic) – analiza archiwum raportów + fallback sentymentu
# Używane przez: claude_analyzer (wnioski w raporcie), claude_sentiment (gdy brak MyFXBook).
# Format: sk-ant-api03-... z console.anthropic.com
# -----------------------------------------------------------------------------
CLAUDE_API_KEY=

# -----------------------------------------------------------------------------
# Dashboard – hasło panelu Admin (Subskrypcje). Puste = zakładka ukryta.
# -----------------------------------------------------------------------------
# ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Serwer raportów (report_server.py) – raporty przy wyłączonym PC (cron w chmurze)
# Używane gdy uruchamiasz report_server na VPS/chmurze i wywołujesz go z cron-job.org.
# -----------------------------------------------------------------------------
# REPORT_CRON_TOKEN=   # dowolny tajny ciąg; podaj w URL: ?token=ten_ciag
# REPORT_SERVER_PORT=8765
